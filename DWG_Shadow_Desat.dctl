// DWG_Shadow_Desat.dctl
// Specialized shadow desaturation DCTL for DaVinci Wide Gamut / DaVinci Intermediate (DWG/DI).
// Uses a strictly positive monotonic L2 shadow mask, a positive-definite Blue-Inset OkLab engine,
// rational C2 smooth5 rolloff, and luma-invariant warm skin protection.
// Hardened for macOS Apple Silicon (Metal Shading Language) fast-math safety and SIMD early-out.

// clang-format off
DEFINE_UI_PARAMS(desat_engine, Desat Engine, DCTLUI_COMBO_BOX, 0, {ENGINE_OKLAB, ENGINE_LINEAR}, {Perceptual OkLab, Linear Luma})
DEFINE_UI_PARAMS(desat_strength, Desat Strength, DCTLUI_SLIDER_FLOAT, 0.85, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(shadow_pivot, Shadow Pivot, DCTLUI_SLIDER_FLOAT, 0.28, 0.09, 0.60, 0.005)
DEFINE_UI_PARAMS(black_floor, Black Floor, DCTLUI_SLIDER_FLOAT, 0.08, 0.0, 0.35, 0.005)
DEFINE_UI_PARAMS(rolloff_curve, Rolloff Curve, DCTLUI_SLIDER_FLOAT, 1.0, 0.40, 2.20, 0.01)
DEFINE_UI_PARAMS(chroma_density, Chroma Density, DCTLUI_SLIDER_FLOAT, -0.08, -0.50, 0.30, 0.01)
DEFINE_UI_PARAMS(warm_protect, Warm Skin Protect, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(preview_mode, Preview - Set Off for LUT, DCTLUI_COMBO_BOX, 0, {PREVIEW_OFF, PREVIEW_HIGHLIGHT, PREVIEW_MASK, PREVIEW_DELTA}, {Off - LUT Safe, Highlight, Shadow Mask, Desat Delta 4x})
// clang-format on

#define DI_A       0.0075f
#define DI_B       7.0f
#define DI_C       0.07329248f
#define DI_M       10.44426855f
#define DI_LIN_CUT 0.00262409f
#define DI_LOG_CUT 0.02740668f

__DEVICE__ float clampf(float x, float lo, float hi) {
    return _fminf(_fmaxf(x, lo), hi);
}

__DEVICE__ float3 add3(float3 a, float3 b) {
    return make_float3(a.x + b.x, a.y + b.y, a.z + b.z);
}

__DEVICE__ float3 scale3(float3 v, float s) {
    return make_float3(v.x * s, v.y * s, v.z * s);
}

__DEVICE__ float3 lerp3(float3 a, float3 b, float t) {
    return make_float3(
        a.x + (b.x - a.x) * t,
        a.y + (b.y - a.y) * t,
        a.z + (b.z - a.z) * t
    );
}

// Metal -ffast-math safe transcendental wrappers (immune to ternary speculative evaluation NaN)
__DEVICE__ float sqrtf_safe(float x) {
    return (x <= 0.0f) ? 0.0f : _sqrtf(_fmaxf(x, 1e-30f));
}

__DEVICE__ float cbrtf_pos(float x) {
    return (x <= 0.0f) ? 0.0f : _powf(_fmaxf(x, 1e-20f), 1.0f / 3.0f);
}

__DEVICE__ float powf_pos(float x, float e) {
    return (x <= 0.0f) ? 0.0f : _powf(_fmaxf(x, 1e-20f), e);
}

__DEVICE__ float di_to_linear(float y) {
    if (y <= DI_LOG_CUT) {
        return y / DI_M;
    }
    return _exp2f((y / DI_C) - DI_B) - DI_A;
}

__DEVICE__ float linear_to_di(float x) {
    float safe_arg = _fmaxf(x + DI_A, 1e-12f);
    if (x <= DI_LIN_CUT) {
        return x * DI_M;
    }
    return (_log2f(safe_arg) + DI_B) * DI_C;
}

__DEVICE__ float3 di_to_linear3(float3 v) {
    return make_float3(di_to_linear(v.x), di_to_linear(v.y), di_to_linear(v.z));
}

__DEVICE__ float3 linear_to_di3(float3 v) {
    return make_float3(linear_to_di(v.x), linear_to_di(v.y), linear_to_di(v.z));
}

// Quintic Hermite step: strictly C2 continuous with zero 1st & 2nd derivatives at endpoints
__DEVICE__ float smooth5(float t) {
    float x = clampf(t, 0.0f, 1.0f);
    return x * x * x * (x * (x * 6.0f - 15.0f) + 10.0f);
}

// Positive-definite Blue-Inset (aB = 0.32) D65-normalized DWG <-> OkLab LMS matrices
// All 9 forward weights > +0.013; row sums strictly = 1.0 for exact neutral-gray invariance.
__DEVICE__ float3 dwg_lin_to_lms_safe(float3 c) {
    return make_float3(
        0.59279668f * c.x + 0.39399130f * c.y + 0.01321202f * c.z,
        0.23707812f * c.x + 0.70170606f * c.y + 0.06121582f * c.z,
        0.03759238f * c.x + 0.13022491f * c.y + 0.83218271f * c.z
    );
}

__DEVICE__ float3 lms_safe_to_dwg_lin(float3 lms) {
    return make_float3(
        2.17619412f * lms.x - 1.23229223f * lms.y + 0.05609811f * lms.z,
       -0.73672953f * lms.x + 1.86200294f * lms.y - 0.12527341f * lms.z,
        0.01698210f * lms.x - 0.23571070f * lms.y + 1.21872859f * lms.z
    );
}

__DEVICE__ float3 lms_cbrt_to_lab(float3 lms_) {
    return make_float3(
        0.21045426f * lms_.x + 0.79361779f * lms_.y - 0.00407205f * lms_.z,
        1.97799850f * lms_.x - 2.42859221f * lms_.y + 0.45059371f * lms_.z,
        0.02590404f * lms_.x + 0.78277177f * lms_.y - 0.80867577f * lms_.z
    );
}

__DEVICE__ float3 lab_to_lms_cbrt(float3 lab) {
    return make_float3(
        1.00000000f * lab.x + 0.39633779f * lab.y + 0.21580376f * lab.z,
        1.00000000f * lab.x - 0.10556134f * lab.y - 0.06385417f * lab.z,
        1.00000000f * lab.x - 0.08948418f * lab.y - 1.29148554f * lab.z
    );
}

__DEVICE__ float3 cube3(float3 v) {
    return make_float3(v.x * v.x * v.x, v.y * v.y * v.y, v.z * v.z * v.z);
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B) {
    float3 in_di = make_float3(p_R, p_G, p_B);
    float3 lin = di_to_linear3(in_di);

    // Clamp UI inputs against manual entry beyond slider bounds
    float strength_val = clampf(desat_strength, 0.0f, 1.0f);
    float curve_val = clampf(rolloff_curve, 0.40f, 2.20f);
    float warm_val = clampf(warm_protect, 0.0f, 1.0f);
    float cd_val = clampf(chroma_density, -0.50f, 0.30f);

    // Non-negative / negative separation (safely absorbs negative excursions from upstream nodes)
    float3 lin_pos = make_float3(_fmaxf(lin.x, 0.0f), _fmaxf(lin.y, 0.0f), _fmaxf(lin.z, 0.0f));
    float3 lin_neg = make_float3(_fminf(lin.x, 0.0f), _fminf(lin.y, 0.0f), _fminf(lin.z, 0.0f));

    // 1. Strictly positive, strictly monotonic L2 perceptual mask metric
    float y_mask = sqrtf_safe(
        0.24f * lin_pos.x * lin_pos.x +
        0.66f * lin_pos.y * lin_pos.y +
        0.10f * lin_pos.z * lin_pos.z
    );
    float luma_di = linear_to_di(y_mask);

    // 2. Shadow weight curve in DI code-value domain with dynamic 33-pt LUT span protection
    // Rational Schlick shaping + quintic smooth5 guarantees C2 smoothness across [0.40, 2.20]
    float min_span = _fminf(0.095f * _fmaxf(curve_val, 1.0f), 0.15f);
    float pivot_val = _fmaxf(shadow_pivot, min_span);
    float floor_val = _fmaxf(_fminf(black_floor, pivot_val - min_span), 0.0f);

    float t = clampf((pivot_val - luma_di) / (pivot_val - floor_val), 0.0f, 1.0f);
    float t_shaped = t / (t + curve_val * (1.0f - t));
    float w_shadow = smooth5(t_shaped);

    // Early-out for midtones/highlights above Shadow Pivot (skips cbrtf/matrices on Apple Silicon GPU)
    float3 highlight_bg = make_float3(0.336043f, 0.336043f, 0.336043f);
    if (w_shadow <= 0.0f) {
        if (preview_mode == PREVIEW_HIGHLIGHT) {
            return highlight_bg;
        }
        if (preview_mode == PREVIEW_MASK || preview_mode == PREVIEW_DELTA) {
            return make_float3(0.0f, 0.0f, 0.0f);
        }
        return in_di;
    }

    // 3. Positive-definite Blue-Inset OkLab conversion (C_inf continuous everywhere)
    float3 lms = dwg_lin_to_lms_safe(lin_pos);
    float3 lms_cbrt = make_float3(cbrtf_pos(lms.x), cbrtf_pos(lms.y), cbrtf_pos(lms.z));
    float3 lab = lms_cbrt_to_lab(lms_cbrt);

    // 4. Warm / Skin hue protection centered at +48 deg in OkLab (a, b) plane
    // Luma-invariant relative-chroma Lorentzian raised-cosine bell (sigma_r = sqrt(0.0030) ~= 0.0548)
    const float cos48 = 0.66913061f;
    const float sin48 = 0.74314483f;
    float C_sq = lab.y * lab.y + lab.z * lab.z;
    float p_warm = _fmaxf(lab.y * cos48 + lab.z * sin48, 0.0f);
    float sigma_sq = 0.0030f * lab.x * lab.x + 1e-8f;
    float warm_w = (p_warm * p_warm) / (C_sq + sigma_sq);

    float w_eff = w_shadow * (1.0f - warm_val * warm_w);
    float desat_amount = strength_val * w_eff;

    // 5-7. Core desaturation & output assembly
    float3 out_di = in_di;
    if (desat_amount > 0.0f) {
        float sat_scale = 1.0f - desat_amount;
        float Y_pos = 0.23694990f * lin_pos.x + 0.75517334f * lin_pos.y + 0.00787676f * lin_pos.z;
        float3 gray_lin = make_float3(Y_pos, Y_pos, Y_pos);

        float3 out_pos = lerp3(lin_pos, gray_lin, desat_amount);
        if (desat_engine == ENGINE_OKLAB) {
            float3 lab_desat = make_float3(lab.x, lab.y * sat_scale, lab.z * sat_scale);
            float3 lms_cbrt_desat = lab_to_lms_cbrt(lab_desat);
            float3 lms_desat = cube3(lms_cbrt_desat);
            out_pos = lms_safe_to_dwg_lin(lms_desat);
            out_pos = make_float3(_fmaxf(out_pos.x, 0.0f), _fmaxf(out_pos.y, 0.0f), _fmaxf(out_pos.z, 0.0f));
        }

        // Converge negative excursions toward their 3-channel mean so sub-black neutral grays stay invariant
        float neg_mean = (lin_neg.x + lin_neg.y + lin_neg.z) * (1.0f / 3.0f);
        float3 out_neg = lerp3(lin_neg, make_float3(neg_mean, neg_mean, neg_mean), desat_amount);
        float3 out_lin = add3(out_pos, out_neg);

        // Chroma-coupled density / HK compensation (strictly zero on neutral grays)
        if (_fabs(cd_val) > 1e-6f) {
            float C_lab = sqrtf_safe(C_sq);
            float rc = (lab.x > 1e-5f) ? (C_lab / lab.x) : 0.0f;
            float chroma_factor = rc / (rc + 0.25f);
            float cd_scale = (cd_val > 0.0f) ? 1.2f : 2.0f;
            float density_gain = _exp2f(cd_val * chroma_factor * desat_amount * cd_scale);
            out_lin = scale3(out_lin, density_gain);
        }

        out_di = linear_to_di3(out_lin);
    }

    if (preview_mode == PREVIEW_HIGHLIGHT) {
        return lerp3(highlight_bg, out_di, w_eff);
    }
    if (preview_mode == PREVIEW_MASK) {
        float mask_di = linear_to_di(powf_pos(clampf(desat_amount, 0.0f, 1.0f), 2.4f));
        return make_float3(mask_di, mask_di, mask_di);
    }
    if (preview_mode == PREVIEW_DELTA) {
        float dr = linear_to_di(powf_pos(clampf(4.0f * _fabs(out_di.x - in_di.x), 0.0f, 1.0f), 2.4f));
        float dg = linear_to_di(powf_pos(clampf(4.0f * _fabs(out_di.y - in_di.y), 0.0f, 1.0f), 2.4f));
        float db = linear_to_di(powf_pos(clampf(4.0f * _fabs(out_di.z - in_di.z), 0.0f, 1.0f), 2.4f));
        return make_float3(dr, dg, db);
    }
    return out_di;
}
